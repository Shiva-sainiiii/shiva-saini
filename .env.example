# ---- Public (browser me bhi jaate hain, isme secret mat rakho) ----
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ---- SERVER-ONLY (kabhi NEXT_PUBLIC_ mat lagana!) ----
# Google AI Studio key (aistudio.google.com/apikey) — chatbot ke liye
GEMINI_API_KEY=
# Optional: model override, comma separated (pehla fail ho to agla try hota hai). Default: gemini-3.1-flash-lite,gemini-2.5-flash-lite
GEMINI_MODEL=
# Firebase service account JSON ka poora content, ek value me (admin se feedback delete karne ke liye)
FIREBASE_SERVICE_ACCOUNT=
