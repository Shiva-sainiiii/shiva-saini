rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /feedback/{id} {
      allow read: if true;
      // Sirf valid 1–5 star review create ho sakta hai; edit/delete band
      allow create: if request.resource.data.keys().hasOnly(['name', 'stars', 'message', 'createdAt'])
        && request.resource.data.stars is int && request.resource.data.stars >= 1 && request.resource.data.stars <= 5
        && request.resource.data.name is string && request.resource.data.name.size() <= 60
        && request.resource.data.message is string && request.resource.data.message.size() <= 500
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }
  }
}
